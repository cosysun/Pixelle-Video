PIXELLE_USERNAME=admin
# 直接填写登录密码，用单引号包裹。
PIXELLE_PASSWORD=''
PIXELLE_DATABASE=data/platform.sqlite3
PIXELLE_TEMP_DIR=/tmp/pixelle
# Docker 宿主机映射端口；NGINX proxy_pass 使用此端口。容器内固定为 8000。
PIXELLE_PORT=8000
# Docker 宿主机绑定地址，默认 127.0.0.1；NGINX 在其他机器时填写应用服务器的内网 IP。
# PIXELLE_BIND_HOST=10.0.0.20
COS_BUCKET=
COS_REGION=
COS_SECRET_ID=
COS_SECRET_KEY=
# 可选：仅使用 STS 临时凭据时填写；长期 SecretId/SecretKey 无需配置。
# COS_SESSION_TOKEN=
COS_PREFIX=pixelle
